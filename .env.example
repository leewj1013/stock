NOTIFIER=telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_REMOTE_ORIGIN=https://leewj1013.github.io
DASHBOARD_REMOTE_TOKEN=
DASHBOARD_REMOTE_PORT=8766
KRX_API_KEY=
FORCE_SEND=0
MARKETS=KOSPI,KOSDAQ
DATA_SOURCE=naver
KOREAN_STOCK_NAMES=1
AUTO_TRACK_PICKS=1
STOCKS=
TOP_N=5
MIN_TRADING_VALUE=5000000000
DYNAMIC_SCREENING_TOP_N=500
VOLUME_MULTIPLIER=1.5
MAX_DAY_CHANGE_PCT=8
MAX_ENTRY_DAY_CHANGE_PCT=5
MAX_MA20_DISTANCE_PCT=10
MAX_MA20_DISTANCE_ATR=1.5
MAX_AVG_RANGE_PCT=12
MIN_MARKET_UP_RATIO=0.25
SELL_LOSS_PCT=5
SELL_DROP_PCT=3
SELL_PROTECT_PROFIT_PCT=5
SELL_GIVEBACK_PCT=4
SELL_RECOMMEND_COOLDOWN_DAYS=3
SELL_RECOMMEND_COOLDOWN_STOP_LOSS_DAYS=5
SELL_RECOMMEND_COOLDOWN_MA20_DAYS=2
SELL_RECOMMEND_COOLDOWN_TIME_STOP_DAYS=3
SELL_RECOMMEND_COOLDOWN_TAKE_PROFIT_DAYS=1
SEND_EMPTY_SELL_ALERT=0
VIRTUAL_TRADER_AUTO_BUY=1
VIRTUAL_TRADER_MIN_POSITION_PCT=10
VIRTUAL_TRADER_MAX_POSITION_PCT=30
VIRTUAL_TRADER_POSITION_SIZING_MODE=fixed
VIRTUAL_TRADER_FIXED_POSITION_PCT=10
# Partial-profit defaults are conservative starting points; tune by backtest before real-account use.
TAKE_PROFIT_1_PCT=10
TAKE_PROFIT_1_SELL_RATIO=50
TAKE_PROFIT_2_PCT=20
PRICE_CLOSE_TOLERANCE_PCT=0.5
# Promotion safety gate: at least 300 valid samples and three 60-sample walk-forward folds.
LEARNING_MIN_SAMPLES=300
LEARNING_MAX_SAMPLES=1000
LEARNING_VALIDATION_MIN_SAMPLES=60
LEARNING_VALIDATION_FOLDS=3
LEARNING_SIGNIFICANCE_LEVEL=0.05
LEARNING_MAX_DAILY_WEIGHT_CHANGE=0.05
EXECUTION_COST_BPS=30
BACKTEST_SLIPPAGE_BPS=10
RISK_DAILY_LOSS_PCT=2
RISK_WEEKLY_LOSS_PCT=5
RISK_MAX_DRAWDOWN_PCT=10
RISK_MAX_EXPOSURE_PCT=70
CORRELATION_LOOKBACK_DAYS=60
CORRELATION_LIMIT=0.8
CORRELATED_GROUP_MAX_PCT=40
# 100이면 비활성. 백테스트 개선 확인 전에는 운영에서 활성화하지 않습니다.
SECTOR_GROUP_MAX_PCT=100
SEND_DAILY_CHECK_ALERT=0
NEWS_LOOKUP=1
# 2026-09-19: 키워드 뉴스 감성은 수익률을 예측하지 못해 점수에서 제외.
NEWS_SCORE_WEIGHT=0
NAVER_OFFICIAL_NEWS_API=0
NAVER_HUB_CLIENT_ID=
NAVER_HUB_CLIENT_SECRET=
MIN_RECOMMEND_SCORE=50
DART_API_KEY=
DART_LOOKUP=0
DART_FINANCIALS_LOOKUP=0
AS_OF_DATE=
BACKTEST_DAYS=20
BACKTEST_HOLD_DAYS=1
# Isolated 3-year+ validation pipeline (writes only data/backtest and reports/backtest).
BACKTEST_START_DATE=2022-01-01
BACKTEST_END_DATE=
BACKTEST_REGIME_MA_DAYS=120
BACKTEST_REGIME_RETURN_DAYS=60
BACKTEST_REGIME_TREND_PCT=5
# Fixed capital fraction used for signal-level MDD aggregation.
BACKTEST_TRADE_ALLOCATION_PCT=10
# Read-only factor analysis. Regimes below 250 sessions are marked sample-limited.
FACTOR_SIGNIFICANCE_LEVEL=0.05
FACTOR_QUANTILES=5
FACTOR_MIN_CROSS_SECTION=5
FACTOR_REGIME_MIN_DAYS=250
# Allow at most this small percentage-point reversal between adjacent quantiles.
FACTOR_MONOTONIC_TOLERANCE_PCT=0.05
# Isolated weight-variant comparison; defaults to the learning promotion alpha.
WEIGHT_VARIANT_SIGNIFICANCE_LEVEL=0.05
# Statistical robustness appendix. Overlapping h-day returns use HAC lag h-1.
STAT_HAC_LAG_POLICY=holding_period_minus_one
STAT_HAC_MAX_LAG=19
STAT_HAC_FIXED_LAG=4
# Variant daily return differences use a conservative five-session HAC lag.
WEIGHT_VARIANT_HAC_LAG=5
STAT_FDR_ALPHA=0.05
# 격리된 외부요인 PIT 저장소. 운영 DB와 분리됩니다.
PIT_STORE_PATH=data/backtest/point_in_time.sqlite3
# API rate limit과 SQLite write contention을 고려한 종목 단위 병렬 수.
PIT_COLLECTION_WORKERS=4
# Expanded factor-power experiment; never replaces data/watchlist.csv.
EXPANDED_UNIVERSE_SIZE=300
EXPANDED_MARKET_CAP_PAGES=8
EXPANDED_BACKTEST_START_DATE=2018-01-01
EXPANDED_BACKTEST_END_DATE=
EXPANDED_COLLECTION_WORKERS=6
EXPANDED_TARGET_POWER=0.80

# 단순 기준전략 비교(분석 전용, 라이브 주문/DB와 무관)
BENCHMARK_RANDOM_ITERATIONS=100
BENCHMARK_RANDOM_SEED=20260828
# 일별 수익률 차이의 주간 자기상관을 허용하는 HAC lag.
BENCHMARK_HAC_LAG=5
BACKTEST_INITIAL_CASH=100000000
TUNE_VOLUME_MULTIPLIERS=1.5,2.0,2.5
TUNE_HOLD_DAYS=1,3,5

# 토스증권 Open API. 실제 값은 보호된 secrets.env에만 저장합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_API_BASE_URL=https://openapi.tossinvest.com
# 현재 stockAlarm 연동은 인증·시세·계좌목록 조회 전용입니다.
TOSS_TRADING_ENABLED=0
# Sensitive values are loaded from %USERPROFILE%\.stockAlarmSecure\secrets.env by
# default. Run scripts/migrate_secrets.ps1 instead of keeping real keys here.
STOCK_ALARM_SECURE_ENV_PATH=

# Shadow mode: size hypothetical orders against this KRW balance instead of the real account's cash (0 = off)
SHADOW_TRADER_ASSUMED_CAPITAL=0

# Daily fundamentals screening (stock_alarm.screener, runs in the 16:00 task).
# Leave a value empty to turn that filter off; SCREENER_MARKETS blank means both.
SCREENER_PER_MAX=15
SCREENER_GROWTH_MIN=5
SCREENER_PBR_MAX=
SCREENER_DIVIDEND_MIN=
SCREENER_OPERATING_GROWTH_MIN=
SCREENER_POSITIVE_FCF=1
SCREENER_MARKETS=

# Telegram recommendation alerts: "bought" sends only when the virtual trader
# actually bought (other picks are listed in the 16:00 briefing); "all" sends
# every recommendation batch as before.
RECOMMENDATION_ALERTS=bought
